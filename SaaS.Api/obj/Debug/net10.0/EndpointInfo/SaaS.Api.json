              "string"
            ],
            "format": "int32"
          },
          "connectedAccountId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "targetGroupId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "infoJson": {
            "type": "string"
          }
        }
      },
      "LoginRequestDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ScrapedLeadDto": {
        "required": [
          "externalId",
          "username",
          "fullName",
          "metadataJson"
        ],
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string"
