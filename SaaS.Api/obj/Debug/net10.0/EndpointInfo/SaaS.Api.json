            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScrapedLeadDto"
            }
          }
        }
      },
      "CreateRunDto": {
        "required": [
          "botId",
          "connectedAccountId",
          "targetGroupId",
          "infoJson"
        ],
        "type": "object",
        "properties": {
